# =============================================================================
# Shared — used by multiple binaries
# =============================================================================

# Solana cluster (bookkeeper, trade-keeper, event-keeper)
CLUSTER_RPC_URL=
CLUSTER_WS_URL=

# Tiger Cloud (TimescaleDB / Postgres) connection — event-keeper, read-api.
# Tiger Cloud requires TLS; include sslmode=require.
# e.g. postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
DATABASE_URL=

# Optional table-name overrides
# (defaults: raw_market_update_events, market_candles_1m, raw_close_position_events)
MARKET_UPDATES_TABLE=
CANDLES_1M_TABLE=
CLOSE_POSITION_EVENTS_TABLE=

# =============================================================================
# bookkeeper
# =============================================================================

PAYER_KEYPAIR=
MARKET_ID=
SLOTS_BETWEEN_UPDATES=

# Monitoring identity and HTTP server. Set BOOKKEEPER_ID to a different value
# for every replica. The bind address falls back to PORT, then 0.0.0.0:8080.
BOOKKEEPER_ID=
BOOKKEEPER_CLUSTER=
BOOKKEEPER_MONITOR_BIND_ADDR=
BOOKKEEPER_MONITOR_ACTIVITY_GRACE_MS=
BOOKKEEPER_BALANCE_POLL_INTERVAL_MS=

# Optional robustness / rate-limit tuning
BOOKKEEPER_MIN_UPDATE_DELAY_MS=
BOOKKEEPER_SEND_RETRY_ATTEMPTS=
BOOKKEEPER_REBROADCAST_INTERVAL_MS=
BOOKKEEPER_RETRY_INITIAL_DELAY_MS=
BOOKKEEPER_RETRY_MAX_DELAY_MS=
BOOKKEEPER_MAX_IDLE_SLEEP_MS=
BOOKKEEPER_ESTIMATED_SLOT_DURATION_MS=
BOOKKEEPER_PRIORITY_FEE_PERCENTILE=
BOOKKEEPER_PRIORITY_FEE_MIN_MICRO_LAMPORTS=
BOOKKEEPER_PRIORITY_FEE_MAX_MICRO_LAMPORTS=
BOOKKEEPER_COMPUTE_UNIT_LIMIT=
BOOKKEEPER_COMPUTE_UNIT_MIN=
BOOKKEEPER_COMPUTE_UNIT_MAX=
BOOKKEEPER_COMPUTE_UNIT_MARGIN_BPS=

# =============================================================================
# bookkeeper-canary (read-only, independent mainnet observation)
# =============================================================================

# Use a mainnet RPC endpoint that is independent from the endpoints used by the
# transaction-sending bookkeepers. The expected genesis hash prevents an RPC
# for another Solana cluster from being mislabeled as mainnet.
BOOKKEEPER_CANARY_RPC_URL=https://api.mainnet.solana.com
BOOKKEEPER_CANARY_CLUSTER=mainnet
BOOKKEEPER_CANARY_PROGRAM_ID=CCAmAqvza37EWzou7LoYCaGKzdJsCu1CLPMp3Wvx3Bc5
BOOKKEEPER_CANARY_MARKET_ID=1
BOOKKEEPER_CANARY_EXPECTED_GENESIS_HASH=5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d
BOOKKEEPER_CANARY_BIND_ADDR=
BOOKKEEPER_CANARY_POLL_INTERVAL_MS=10000
BOOKKEEPER_CANARY_STALE_AFTER_MS=45000

# =============================================================================
# read-api
# =============================================================================

# Override shared DATABASE_URL for read-api only (optional)
READ_API_DATABASE_URL=

# Server binding — falls back to PORT, then 0.0.0.0:8080
READ_API_BIND_ADDR=
PORT=

# Backend polling interval per active market price stream (default: 1000)
READ_API_PRICE_STREAM_POLL_MS=
