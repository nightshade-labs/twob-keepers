prometheus.scrape "ant_oracle" {
  targets = [
    {
      "__address__" = "ant-oracle.railway.internal:8080",
      "instance" = "ant-oracle",
      "service" = "market-maker",
      "market_address" = "H16ZeZee8yGw94kGVx4aEHmC8PwWjwuLuqsW2g8MK2Pz",
    },
  ]
  scheme = "http"
  metrics_path = "/metrics"
  job_name = "ant-oracle"
  scrape_interval = "10s"
  scrape_timeout = "5s"
  honor_labels = true
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// /health is 503 when the source observation expires, even if cached fetches succeed.
prometheus.exporter.blackbox "ant_oracle" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 4s } } }"
  target {
    name = "ant-oracle-health"
    address = "http://ant-oracle.railway.internal:8080/health"
    module = "http_2xx"
    labels = {
      "market_address" = "H16ZeZee8yGw94kGVx4aEHmC8PwWjwuLuqsW2g8MK2Pz",
      "service" = "market-maker",
      "pair" = "ANT/USDC",
    }
  }
}

prometheus.scrape "ant_oracle_health" {
  targets = prometheus.exporter.blackbox.ant_oracle.targets
  job_name = "ant-oracle-health"
  scrape_interval = "10s"
  scrape_timeout = "5s"
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}
