    "instance" = "permissionless-chain-GxyExYjbyEKm8ezdzYVgMtYA3gms76KghxRyd4tzTnT5",
    "service" = "market-maker",
    "market_address" = "FUDH6hiwDNjdQKbH7fveFFPoEE3mXk9i1g2WbgnSqob3",
    "position_address" = "GxyExYjbyEKm8ezdzYVgMtYA3gms76KghxRyd4tzTnT5",
    "program_id" = "TwobwMYkKbT8uMWqgPrEPXTPoyYsKAPmaWun6T2WT4A",
    "maker_kind" = "permissionless",
  }]

  scheme = "http"
  metrics_path = "/metrics"
  job_name = "permissionless-monitor"
  scrape_interval = "10s"
  scrape_timeout = "5s"
  honor_labels = true

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
