logging {
	level  = "info"
	format = "logfmt"
}

prometheus.scrape "bookkeepers" {
	targets = [
		{
			"__address__" = "bookkeeper.railway.internal:8080",
			"instance"    = "mainnet-market-1",
		},
		{
			"__address__" = "bookkeeper-backup.railway.internal:8080",
			"instance"    = "mainnet-market-1-backup",
		},
	]

	scheme          = "http"
	metrics_path    = "/metrics"
	job_name        = "bookkeeper"
	scrape_interval = "10s"
	scrape_timeout  = "5s"

	forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "bookkeeper_canary" {
	targets = [
		{
			"__address__" = "bookkeeper-canary.railway.internal:8080",
			"instance"    = "mainnet-market-1-chain",
		},
	]

	scheme          = "http"
	metrics_path    = "/metrics"
	job_name        = "bookkeeper-canary"
	scrape_interval = "10s"
	scrape_timeout  = "5s"

	forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
	external_labels = {
		collector   = "railway-alloy",
		environment = "mainnet",
	}

	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
			password = sys.env("GRAFANA_CLOUD_API_TOKEN")
		}
	}
}

// Add these scrape components to the existing bookkeeper-alloy config.
// Reuses prometheus.remote_write.grafana_cloud and environment="mainnet".
// Set target variables in Railway using the service reference variables:
// MARKET_MAKER_METRICS_ADDRESS=${{cca-market-maker.RAILWAY_PRIVATE_DOMAIN}}:8080
// MAKER_MONITOR_METRICS_ADDRESS=${{maker-monitor.RAILWAY_PRIVATE_DOMAIN}}:8080
// Both exporters must listen on [::]:8080 in the same project/environment.

prometheus.scrape "market_maker" {
  targets = [{
    "__address__" = sys.env("MARKET_MAKER_METRICS_ADDRESS"),
    "instance" = "mainnet-market-maker",
    "service" = "market-maker",
    "market_address" = "FUDH6hiwDNjdQKbH7fveFFPoEE3mXk9i1g2WbgnSqob3",
  }]

  scheme = "http"
  metrics_path = "/metrics"
  job_name = "market-maker"
  scrape_interval = "10s"
  scrape_timeout = "5s"
  honor_labels = true

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "maker_monitor" {
  targets = [{
    "__address__" = sys.env("MAKER_MONITOR_METRICS_ADDRESS"),
    "instance" = "mainnet-market-maker-chain",
    "service" = "market-maker",
    "market_address" = "FUDH6hiwDNjdQKbH7fveFFPoEE3mXk9i1g2WbgnSqob3",
  }]

  scheme = "http"
  metrics_path = "/metrics"
  job_name = "maker-monitor"
  scrape_interval = "10s"
  scrape_timeout = "5s"
  honor_labels = true

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}
